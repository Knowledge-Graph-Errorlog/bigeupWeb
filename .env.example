# 복사해서 .env.local 로 쓴다 (git에 안 올라감). 모두 공개 값이다. 시크릿 키는 서버(backend)에만 둔다.
VITE_API_BASE_URL=https://dev-api.bigeup.com
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SERVICES_ID=
VITE_KAKAO_REST_KEY=
VITE_NAVER_CLIENT_ID=
# 결제사 심사용: 로그인 화면에 '아이디로 로그인'(테스트 계정). 아이디·비밀번호는 서버 설정에만 있다
VITE_REVIEW_LOGIN=
# 개발 서버에서만: 소셜 없이 들어가는 개발용 로그인 버튼
VITE_DEV_LOGIN=
