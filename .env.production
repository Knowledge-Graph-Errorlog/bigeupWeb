# 운영 빌드(Vercel) 기본값. 모두 공개 값이다 (시크릿은 서버에만).
# Vercel › Settings › Environment Variables에 같은 이름을 넣으면 그 값이 이긴다.

# 운영 서버(api.bigeup.com)가 생길 때까지 개발 서버를 쓴다 (출시 때 바꾼다)
VITE_API_BASE_URL=https://dev-api.bigeup.com

# 구글 웹 클라이언트 ID (앱 frontend src/auth/socialConfig.ts 와 같은 값, 서버 GOOGLE_CLIENT_IDS 와 짝)
# 구글 콘솔 '승인된 JavaScript 원본'에 https://www.bigeup.com 이 있어야 버튼이 동작한다
VITE_GOOGLE_CLIENT_ID=212068324382-v6uj3rb4r1frr8aoefd24g6cleggchb1.apps.googleusercontent.com

# 카카오 REST API 키 (인가 요청의 client_id라 공개 값). 서버 KAKAO_REST_API_KEY·KAKAO_APP_KEYS·KAKAO_WEB_REDIRECT_URIS,
# 카카오 콘솔 리다이렉트 URI(https://www.bigeup.com/auth/kakao/callback)와 짝이 맞아야 로그인된다
VITE_KAKAO_REST_KEY=f991864eb9a1faab8225dc45ac4bae9b

# 애플 웹용 Services ID (Return URL https://www.bigeup.com/login). 서버 APPLE_CLIENT_IDS 에도 있어야 로그인된다
VITE_APPLE_SERVICES_ID=com.bigeup.web
